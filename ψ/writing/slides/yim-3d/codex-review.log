   417	    const t = -cam.position.z / dir.z;
   418	    return cam.position.clone().addScaledVector(dir, t);
   419	  }
   420	  const anchors = [], textBoxes = [];
   421	  function measure(k) {
   422	    const s = slides[k]; if (!s.classList.contains('on')) return;
   423	    s.classList.add('measuring');                       // read the resting layout, not the entrance offset
   424	    const sr = stageEl.getBoundingClientRect(), sc = sr.width / 1920;
   425	    const box = el => { const b = el.getBoundingClientRect();
   426	      return { l: (b.left - sr.left) / sc, t: (b.top - sr.top) / sc, r: (b.right - sr.left) / sc, b: (b.bottom - sr.top) / sc }; };
   427	    // ring slide: 4 ring nodes (clockwise from top), then ψ/, then the ring itself
   428	    const els = s.dataset.anchors === 'ring' ? ['.anc-n', '.anc-c', '.anc-ring'].flatMap(q => [...s.querySelectorAll(q)]) : [...s.querySelectorAll('.anc')];
   429	    anchors[k] = els.map(el => {
   430	      const q = box(el), cx = (q.l + q.r) / 2, cy = (q.t + q.b) / 2, w = q.r - q.l, h = q.b - q.t;
   431	      const c = worldAt(cx, cy, poseCam[k]);
   432	      const ex = worldAt(cx + Math.min(w, h) / 2, cy, poseCam[k]);
   433	      const ey = worldAt(cx, cy - h / 2, poseCam[k]);
   434	      const ex2 = worldAt(cx + w / 2, cy, poseCam[k]);
   435	      return { x: c.x, y: c.y, r: ex.distanceTo(c), hw: ex2.distanceTo(c), hh: ey.distanceTo(c) };
   436	    });
   437	    // words on this slide: no mote may pass under them. svg diagrams only keep the background dust out.
   438	    textBoxes[k] = [...s.querySelectorAll('h1,h2,p,li,.row,svg,svg text')].map(el => { const tg = el.tagName.toLowerCase();
   439	      return Object.assign(box(el), { dustOnly: tg === 'svg', pad: tg === 'text' ? 30 : PAD }); });
   440	    s.classList.remove('measuring');
   441	  }
   442	
   443	  const ZERO = { x: 0, y: 0, r: 2, hw: 2, hh: 2 };
   444	  const out = { x: 0, y: 0, z: 0, s: 1, c: 0, f: 0, dust: false };
   445	  function put(x, y, z, s, c, f = 0) { out.x = x; out.y = y; out.z = z; out.s = s; out.c = c; out.f = f; out.dust = false; }
   446	  function dust(i, t) {
   447	    const r = R[i];
   448	    put((r[0] - 0.5) * 70 + Math.sin(t * 0.04 + i) * 0.5, (r[1] - 0.5) * 40 + Math.cos(t * 0.03 + i) * 0.35, -10 - r[2] * 30, 0.55 + r[3] * 0.7, 1);
   449	    out.dust = true;
   450	  }
   451	  function sphere(c, rad, k, n, t, spin, z0 = 0) {   // fibonacci shell, spinning about y
   452	    const y = 1 - 2 * (k + 0.5) / n, rr = Math.sqrt(1 - y * y), th = k * 2.39996 + t * spin;
   453	    return [c.x + Math.cos(th) * rr * rad, c.y + y * rad, z0 + Math.sin(th) * rr * rad];
   454	  }
   455	  const PENTA = (c, rad, t, tilt) => Array.from({ length: 5 }, (_, j) => {
   456	    const a = Math.PI / 2 + j * 2 * Math.PI / 5 + t * 0.12;
   457	    return { x: c.x + Math.cos(a) * rad, y: c.y + Math.sin(a) * rad * Math.cos(tilt), z: Math.sin(a) * rad * Math.sin(tilt) };
   458	  });
   459	  const EDGES = []; for (let a = 0; a < 5; a++) for (let b = a + 1; b < 5; b++) EDGES.push([a, b]);
   460	  function messenger(nodes, j, i, t, speed, c = 2) {
   461	    const [a, b] = EDGES[j % EDGES.length], A = nodes[a], B = nodes[b];
   462	    let u = frac(R[i][0] + t * speed * (0.6 + R[i][1] * 0.8)); if (R[i][2] > 0.5) u = 1 - u;
   463	    put(A.x + (B.x - A.x) * u, A.y + (B.y - A.y) * u, (A.z || 0) + ((B.z || 0) - (A.z || 0)) * u + Math.sin(u * Math.PI) * 0.8, 0.7, c);
   464	  }
   465	  const lerp3 = (A, B, u, lift = 0) => [A.x + (B.x - A.x) * u, A.y + (B.y - A.y) * u, (A.z || 0) + ((B.z || 0) - (A.z || 0)) * u + Math.sin(u * Math.PI) * lift];
   466	
   467	  // formation per slide: every mote gets a target (position, scale, colour slot, flatness)
   468	  const F = [
   469	    (i, t, A) => {                       // 1: lone node | buried node | five agents
   470	      const a0 = A[0] || ZERO, a1 = A[1] || ZERO, a2 = A[2] || ZERO;
   471	      if (i < 1) return put(a0.x, a0.y, 0, 2.6, 0);
   472	      if (i < 41) { const p = sphere(a0, a0.r * 0.32, i - 1, 40, t, 0.3); return put(...p, 1, 2); }
   473	      if (i < 53) { const k = i - 41, a = k / 12 * Math.PI * 2 + t * 0.25;   // the chat that has to be retold
   474	        return put(a0.x + Math.cos(a) * a0.r * 0.75, a0.y + Math.sin(a) * a0.r * 0.42, Math.sin(a * 2) * 0.4, 0.6, 0); }
   475	      if (i < 54) return put(a1.x, a1.y, 0, 2.6, 0);
   476	      if (i < 94) { const p = sphere(a1, a1.r * 0.32, i - 54, 40, t, 0.3); return put(...p, 1, 2); }
   477	      if (i < 244) { const r = R[i], rad = a1.r * (0.42 + 0.5 * Math.cbrt(r[0])), th = r[1] * Math.PI * 2, ph = Math.acos(2 * r[2] - 1);
   478	        const j = 0.04 * Math.sin(t * 2 + i);        // the pile: work waiting on one person
   479	        return put(a1.x + rad * Math.sin(ph) * Math.cos(th) + j, a1.y + rad * Math.cos(ph) * 0.62 + j, rad * Math.sin(ph) * Math.sin(th) * 0.6, 0.85, r[3] > 0.3 ? 1 : 0, 0.6); }
   480	      if (i < 324) { const r = R[i], u = frac(r[0] + t * 0.09);      // more work still arriving
