   463	    put(A.x + (B.x - A.x) * u, A.y + (B.y - A.y) * u, (A.z || 0) + ((B.z || 0) - (A.z || 0)) * u + Math.sin(u * Math.PI) * 0.8, 0.7, c);
   464	  }
   465	  const lerp3 = (A, B, u, lift = 0) => [A.x + (B.x - A.x) * u, A.y + (B.y - A.y) * u, (A.z || 0) + ((B.z || 0) - (A.z || 0)) * u + Math.sin(u * Math.PI) * lift];
   466	
   467	  // formation per slide: every mote gets a target (position, scale, colour slot, flatness)
   468	  const F = [
   469	    (i, t, A) => {                       // 1: lone node | buried node | five agents
   470	      const a0 = A[0] || ZERO, a1 = A[1] || ZERO, a2 = A[2] || ZERO;
   471	      if (i < 1) return put(a0.x, a0.y, 0, 2.6, 0);
   472	      if (i < 41) { const p = sphere(a0, a0.r * 0.32, i - 1, 40, t, 0.3); return put(...p, 1, 2); }
   473	      if (i < 53) { const k = i - 41, a = k / 12 * Math.PI * 2 + t * 0.25;   // the chat that has to be retold
   474	        return put(a0.x + Math.cos(a) * a0.r * 0.75, a0.y + Math.sin(a) * a0.r * 0.42, Math.sin(a * 2) * 0.4, 0.6, 0); }
   475	      if (i < 54) return put(a1.x, a1.y, 0, 2.6, 0);
   476	      if (i < 94) { const p = sphere(a1, a1.r * 0.32, i - 54, 40, t, 0.3); return put(...p, 1, 2); }
   477	      if (i < 244) { const r = R[i], rad = a1.r * (0.42 + 0.5 * Math.cbrt(r[0])), th = r[1] * Math.PI * 2, ph = Math.acos(2 * r[2] - 1);
   478	        const j = 0.04 * Math.sin(t * 2 + i);        // the pile: work waiting on one person
   479	        return put(a1.x + rad * Math.sin(ph) * Math.cos(th) + j, a1.y + rad * Math.cos(ph) * 0.62 + j, rad * Math.sin(ph) * Math.sin(th) * 0.6, 0.85, r[3] > 0.3 ? 1 : 0, 0.6); }
   480	      if (i < 324) { const r = R[i], u = frac(r[0] + t * 0.09);      // more work still arriving
