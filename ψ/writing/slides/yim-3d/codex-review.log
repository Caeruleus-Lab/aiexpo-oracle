   399	    sh.fragmentShader = sh.fragmentShader.replace('#include <emissivemap_fragment>',
   400	      '#include <emissivemap_fragment>\n  totalEmissiveRadiance += diffuseColor.rgb * 0.22;');
   401	  };
   402	  const mesh = new THREE.InstancedMesh(geo, mat, N);
   403	  mesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
   404	  mesh.frustumCulled = false;
   405	  scene.add(mesh);
   406	
   407	  let _s = 0.731; const rng = () => (_s = Math.sin(_s * 99991) * 9973, _s - Math.floor(_s));
   408	  const R = Array.from({ length: N }, () => [rng(), rng(), rng(), rng(), rng()]);
