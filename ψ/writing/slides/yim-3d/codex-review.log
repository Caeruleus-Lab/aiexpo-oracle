   338	<script type="module">
   339	import * as THREE from 'three';
   340	try {
   341	  const canvas = document.getElementById('world');
   342	  const stageEl = document.getElementById('stage');
   343	  const slides = [...document.querySelectorAll('.slide')];
   344	  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
   345	  const capture = document.documentElement.classList.contains('capture');
   346	  const DUR = 0.85;                                   // one move per slide change, seconds
   347	  const PAD = 40;                                     // px of clear air kept around every word
   348	
   349	  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
   350	  renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 1.5));
   351	  renderer.setSize(1920, 1080, false);
   352	  renderer.setClearColor(0, 0);                       // fully transparent: the CSS paper shows through
   353	
   354	  // tokens: the 3D reads the same CSS custom properties as the HTML
   355	  const probe = document.createElement('canvas').getContext('2d', { willReadFrequently: true });
   356	  const rootStyle = getComputedStyle(document.documentElement);
   357	  function tok(name) {
   358	    const v = rootStyle.getPropertyValue(name).trim();
   359	    if (!v) throw new Error('missing colour token ' + name);   // a missing token must fail, not paint black
   360	    probe.clearRect(0, 0, 1, 1); probe.fillStyle = v;
   361	    probe.fillRect(0, 0, 1, 1); const d = probe.getImageData(0, 0, 1, 1).data;
   362	    return new THREE.Color().setRGB(d[0] / 255, d[1] / 255, d[2] / 255, THREE.SRGBColorSpace);
   363	  }
   364	  const PAL = {                                     // slot 0 key (Yim, work in motion) · 1 waiting · 2 agents
   365	    dark:  ['--mote-key', '--mote-wait', '--mote-agent'].map(tok),
   366	    amber: ['--mote-key-on-amber', '--mote-wait-on-amber', '--mote-agent-on-amber'].map(tok),
   367	  };
   368	  const BG = { dark: tok('--color-paper'), amber: tok('--color-accent') };
   369	
   370	  const scene = new THREE.Scene();
   371	  scene.fog = new THREE.Fog(BG.dark.clone(), 28, 64);     // dust fades into the paper, gives depth for free
   372	  const camera = new THREE.PerspectiveCamera(40, 1920 / 1080, 0.1, 200);
   373	  // the camera path is the story: wide establishing · in to the team · down into the house · up over the day ·
   374	  // back to see everything made · close on the one node that lights the room
   375	  const POSES = [
   376	    { p: [0, 0, 24],     l: [0, 0, 0] },
   377	    { p: [5, 2.5, 21],   l: [2, 0.5, 0] },
   378	    { p: [-3.5, -3, 22], l: [-1, -0.4, 0] },
   379	    { p: [0, 4.5, 22],   l: [0, 0.6, 0] },
   380	    { p: [0, 3, 26],     l: [0, 1, 0] },
   381	    { p: [5, -0.8, 17],  l: [3, 0, 0] },
   382	  ];
   383	  const poseCam = POSES.map(o => {
   384	    const c = camera.clone(); c.position.set(...o.p); c.lookAt(...o.l); c.updateMatrixWorld(); c.updateProjectionMatrix(); return c;
   385	  });
   386	  camera.position.set(...POSES[0].p);
   387	  const look = new THREE.Vector3(...POSES[0].l);
   388	
   389	  // three lights, no more: soft fill, warm key, neutral rim from behind
   390	  scene.add(new THREE.AmbientLight(tok('--light-fill'), 1.05));
   391	  const key = new THREE.DirectionalLight(tok('--light-key'), 2.1); key.position.set(6, 9, 10); scene.add(key);
   392	  const rim = new THREE.DirectionalLight(tok('--light-rim'), 1.1); rim.position.set(-7, 3, -9); scene.add(rim);
   393	
   394	  const N = 1000;
   395	  const geo = new THREE.IcosahedronGeometry(0.12, 0);
