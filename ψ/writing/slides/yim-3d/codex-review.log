   410	  const ease = u => u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2;   // matches --ease-move
   411	
   412	  // anchors: unproject an element's box onto z=0 at the slide's camera pose
   413	  const ndc = new THREE.Vector3(), dir = new THREE.Vector3();
   414	  function worldAt(px, py, cam) {
