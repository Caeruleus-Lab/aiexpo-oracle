<script>
// navigation layer: works with no WebGL, no CDN, no module support
if (navigator.webdriver && !/[?&]live\b/.test(location.search)) document.documentElement.classList.add('capture');
const S=[...document.querySelectorAll('.slide')];let i=0;
const stage=document.getElementById('stage'),prog=document.getElementById('prog');
function fit(){const s=Math.min(innerWidth/1920,innerHeight/1080);stage.style.transform=`translate(-50%,-50%) scale(${s})`}
function go(n){i=Math.max(0,Math.min(S.length-1,n));S.forEach((x,k)=>x.classList.toggle('on',k===i));
  stage.classList.toggle('amber',S[i].classList.contains('amber'));
  prog.style.width=((i+1)/S.length*100)+'%';
  document.getElementById('count').textContent=(i+1)+' / '+S.length;history.replaceState(null,'','#'+(i+1));
  window.__slide=i;dispatchEvent(new CustomEvent('slide',{detail:i}))}
addEventListener('keydown',e=>{if(e.altKey||e.metaKey||e.ctrlKey)return;if(['ArrowRight','PageDown',' '].includes(e.key)){e.preventDefault();go(i+1)}else if(['ArrowLeft','PageUp'].includes(e.key))go(i-1);else if(e.key==='Home')go(0);else if(e.key==='End')go(S.length-1);else if(e.key==='n'||e.key==='N')document.body.classList.toggle('shownotes')});
addEventListener('resize',fit);fit();go((parseInt(location.hash.slice(1))||1)-1);
</script>

<!-- 3D world: one InstancedMesh of motes (1 draw call) that morphs per slide. Optional layer. -->
<script type="importmap">
{ "imports": { "three": "https://cdn.jsdelivr.net/npm/three@0.169.0/build/three.module.js" } }
</script>
<script type="module">
import * as THREE from 'three';
try {
  const canvas = document.getElementById('world');
  const stageEl = document.getElementById('stage');
  const slides = [...document.querySelectorAll('.slide')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const capture = document.documentElement.classList.contains('capture');
  const DUR = 0.85;                                   // one move per slide change, seconds
  const PAD = 40;                                     // px of clear air kept around every word

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
  renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 1.5));
  renderer.setSize(1920, 1080, false);
  renderer.setClearColor(0, 0);                       // fully transparent: the CSS paper shows through

  // tokens: the 3D reads the same CSS custom properties as the HTML
  const probe = document.createElement('canvas').getContext('2d', { willReadFrequently: true });
  const rootStyle = getComputedStyle(document.documentElement);
  function tok(name) {
    const v = rootStyle.getPropertyValue(name).trim();
    if (!v) throw new Error('missing colour token ' + name);   // a missing token must fail, not paint black
    probe.clearRect(0, 0, 1, 1); probe.fillStyle = v;
    probe.fillRect(0, 0, 1, 1); const d = probe.getImageData(0, 0, 1, 1).data;
    return new THREE.Color().setRGB(d[0] / 255, d[1] / 255, d[2] / 255, THREE.SRGBColorSpace);
  }
  const PAL = {                                     // slot 0 key (Yim, work in motion) · 1 waiting · 2 agents
    dark:  ['--mote-key', '--mote-wait', '--mote-agent'].map(tok),
    amber: ['--mote-key-on-amber', '--mote-wait-on-amber', '--mote-agent-on-amber'].map(tok),
  };
  const BG = { dark: tok('--color-paper'), amber: tok('--color-accent') };

  const scene = new THREE.Scene();
  scene.fog = new THREE.Fog(BG.dark.clone(), 28, 64);     // dust fades into the paper, gives depth for free
  const camera = new THREE.PerspectiveCamera(40, 1920 / 1080, 0.1, 200);
  // the camera path is the story: wide establishing · in to the team · down into the house · up over the day ·
  // back to see everything made · close on the one node that lights the room
  const POSES = [
    { p: [0, 0, 24],     l: [0, 0, 0] },
    { p: [5, 2.5, 21],   l: [2, 0.5, 0] },
    { p: [-3.5, -3, 22], l: [-1, -0.4, 0] },
    { p: [0, 4.5, 22],   l: [0, 0.6, 0] },
    { p: [0, 3, 26],     l: [0, 1, 0] },
    { p: [5, -0.8, 17],  l: [3, 0, 0] },
  ];
  const poseCam = POSES.map(o => {
    const c = camera.clone(); c.position.set(...o.p); c.lookAt(...o.l); c.updateMatrixWorld(); c.updateProjectionMatrix(); return c;
  });
  camera.position.set(...POSES[0].p);
  const look = new THREE.Vector3(...POSES[0].l);

  // three lights, no more: soft fill, warm key, neutral rim from behind
  scene.add(new THREE.AmbientLight(tok('--light-fill'), 1.05));
  const key = new THREE.DirectionalLight(tok('--light-key'), 2.1); key.position.set(6, 9, 10); scene.add(key);
  const rim = new THREE.DirectionalLight(tok('--light-rim'), 1.1); rim.position.set(-7, 3, -9); scene.add(rim);

  const N = 1000;
  const geo = new THREE.IcosahedronGeometry(0.12, 0);
  const mat = new THREE.MeshStandardMaterial({ roughness: 0.5, metalness: 0.08 });
  // a little self light from each mote's own colour, so the motes read as lamps, not plastic
  mat.onBeforeCompile = sh => {
    sh.fragmentShader = sh.fragmentShader.replace('#include <emissivemap_fragment>',
      '#include <emissivemap_fragment>\n  totalEmissiveRadiance += diffuseColor.rgb * 0.22;');
  };
  const mesh = new THREE.InstancedMesh(geo, mat, N);
  mesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
  mesh.frustumCulled = false;
  scene.add(mesh);

  let _s = 0.731; const rng = () => (_s = Math.sin(_s * 99991) * 9973, _s - Math.floor(_s));
  const R = Array.from({ length: N }, () => [rng(), rng(), rng(), rng(), rng()]);
  const frac = x => x - Math.floor(x);
  const ease = u => u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2;   // matches --ease-move

  // anchors: unproject an element's box onto z=0 at the slide's camera pose
  const ndc = new THREE.Vector3(), dir = new THREE.Vector3();
  function worldAt(px, py, cam) {
    ndc.set(px / 960 - 1, 1 - py / 540, 0.5).unproject(cam);
    dir.copy(ndc).sub(cam.position).normalize();
    const t = -cam.position.z / dir.z;
    return cam.position.clone().addScaledVector(dir, t);
  }
  const anchors = [], textBoxes = [];
  function measure(k) {
    const s = slides[k]; if (!s.classList.contains('on')) return;
    s.classList.add('measuring');                       // read the resting layout, not the entrance offset
    const sr = stageEl.getBoundingClientRect(), sc = sr.width / 1920;
    const box = el => { const b = el.getBoundingClientRect();
      return { l: (b.left - sr.left) / sc, t: (b.top - sr.top) / sc, r: (b.right - sr.left) / sc, b: (b.bottom - sr.top) / sc }; };
    // ring slide: 4 ring nodes (clockwise from top), then ψ/, then the ring itself
    const els = s.dataset.anchors === 'ring' ? ['.anc-n', '.anc-c', '.anc-ring'].flatMap(q => [...s.querySelectorAll(q)]) : [...s.querySelectorAll('.anc')];
    anchors[k] = els.map(el => {
      const q = box(el), cx = (q.l + q.r) / 2, cy = (q.t + q.b) / 2, w = q.r - q.l, h = q.b - q.t;
      const c = worldAt(cx, cy, poseCam[k]);
      const ex = worldAt(cx + Math.min(w, h) / 2, cy, poseCam[k]);
      const ey = worldAt(cx, cy - h / 2, poseCam[k]);
      const ex2 = worldAt(cx + w / 2, cy, poseCam[k]);
      return { x: c.x, y: c.y, r: ex.distanceTo(c), hw: ex2.distanceTo(c), hh: ey.distanceTo(c) };
    });
    // words on this slide: no mote may pass under them. svg diagrams only keep the background dust out.
    textBoxes[k] = [...s.querySelectorAll('h1,h2,p,li,.row,svg,svg text')].map(el => { const tg = el.tagName.toLowerCase();
      return Object.assign(box(el), { dustOnly: tg === 'svg', pad: tg === 'text' ? 30 : PAD }); });
    s.classList.remove('measuring');
  }

