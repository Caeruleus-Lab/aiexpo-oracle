   267	        <path d="M 725 570 A 300 300 0 0 1 570 725" class="d-arc" fill="none" stroke-width="6" marker-end="url(#ah)"/>
   268	        <path d="M 330 725 A 300 300 0 0 1 175 570" class="d-arc" fill="none" stroke-width="6" marker-end="url(#ah)"/>
   269	        <path d="M 175 330 A 300 300 0 0 1 330 175" class="d-arc" fill="none" stroke-width="6" marker-end="url(#ah)"/>
   270	        <circle class="anc-c d-hub" cx="450" cy="450" r="130" stroke-width="5"/>
