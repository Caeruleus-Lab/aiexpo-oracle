    68	  --mote-key:var(--amber-500);        /* Yim, her knowledge, work in motion */
    69	  --mote-wait:oklch(52% 0.018 260);   /* work waiting, outsiders, background dust */
    70	  --mote-agent:var(--ivory-200);      /* agents */
    71	  --mote-key-on-amber:oklch(98% 0.03 90);     /* on the amber close the key colour is light itself */
    72	  --mote-wait-on-amber:oklch(87% 0.1 85);
    73	  --mote-agent-on-amber:oklch(24% 0.03 70);
    74	
    75	  --font-display:"Bai Jamjuree","Sarabun","Noto Sans Thai","Sukhumvit Set",Thonburi,sans-serif;
    76	  --font-body:"Sarabun","Bai Jamjuree","Noto Sans Thai","Sukhumvit Set",Thonburi,sans-serif;
    77	  --font-mono:ui-monospace,"SF Mono",Menlo,monospace;
    78	  --space-xs:12px;--space-sm:24px;--space-md:40px;--space-lg:64px;--space-xl:96px;--space-2xl:140px;
    79	  --text-sm:30px;--text-md:40px;--text-lg:52px;--text-xl:72px;--text-display:156px;
    80	  --radius:20px;--rule-w:4px;
    81	  --dur-move:850ms;--dur-bg:250ms;--ease-move:cubic-bezier(.65,0,.35,1);--ease-out:cubic-bezier(.2,.7,.2,1);
    82	}
    83	*{margin:0;padding:0;box-sizing:border-box}
    84	html,body{width:100%;height:100%;background:var(--color-letterbox);overflow:hidden}
    85	#stage{position:absolute;left:50%;top:50%;width:1920px;height:1080px;transform-origin:center center;overflow:hidden;
    86	  background:var(--color-paper);transition:background-color var(--dur-bg) var(--ease-out)}
    87	#stage.amber{background:var(--color-accent)}
    88	#world{position:absolute;inset:0;width:1920px;height:1080px;z-index:0;display:block}
    89	.vig{position:absolute;inset:0;z-index:0;pointer-events:none;
    90	  background:radial-gradient(ellipse 75% 70% at 50% 46%,transparent 58%,var(--color-vignette) 100%);transition:opacity var(--dur-move)}
    91	#stage.amber .vig{opacity:0}
    92	.slide{position:absolute;inset:0;z-index:1;display:none;color:var(--color-ink);font-family:var(--font-body)}
    93	.slide.on{display:block}
    94	.slide.amber{color:var(--color-accent-ink)}
    95	.frame{position:absolute;inset:0;padding:var(--space-xl) var(--space-2xl);display:grid;align-content:center;gap:var(--space-lg)}
    96	h1,h2,.display{font-family:var(--font-display);font-weight:700;letter-spacing:0;line-height:1.08}
    97	h2{font-size:var(--text-xl);line-height:1.2}
    98	.display{font-size:var(--text-display)}
    99	.hl{color:var(--color-accent)}
   100	.lead{font-size:var(--text-lg);line-height:1.45;color:var(--color-ink-2)}
   101	.meta{font-size:var(--text-md);color:var(--color-ink-2)}
   102	.foot{font-size:var(--text-sm);color:var(--color-ink-3)}
   103	.nw{white-space:nowrap}
   104	.lamp{position:absolute;left:var(--space-2xl);top:var(--space-xl);width:120px;height:var(--rule-w);background:var(--color-accent)}
   105	.anc{min-height:0}
   106	
   107	/* entrance: text arrives once per slide, after the background has turned, staggered, never loops
   108	   (200 ms + up to 210 ms stagger + 460 ms = 870 ms; on the amber close it waits 300 ms for the amber to land) */
   109	.slide.on .rv{animation:rise .46s var(--ease-out) both;animation-delay:calc(200ms + var(--d,0) * 70ms)}
   110	.slide.amber.on .rv{animation-delay:300ms}
   111	@keyframes rise{from{opacity:0;transform:translateY(18px)}}
   112	.capture .slide.on .rv,.slide.measuring .rv{animation:none!important}
   113	.capture #stage,.capture .vig{transition:none}
   114	
   115	/* 1 three stages */
   116	.who{display:grid;gap:var(--space-xs)}
   117	.who .name{font-family:var(--font-display);font-size:var(--text-xl);font-weight:700;line-height:1.1}
   118	.stages{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-md)}
   119	.stages .anc{height:270px}
   120	.stages .card{border-top:var(--rule-w) solid var(--color-rule);padding-top:var(--space-sm)}
   121	.stages .on .card{border-top-color:var(--color-accent)}
   122	.stages .k{font-family:var(--font-display);font-size:var(--text-md);font-weight:600;color:var(--color-ink-3)}
   123	.stages .on .k{color:var(--color-accent)}
   124	.stages .t{white-space:nowrap;font-family:var(--font-display);font-size:var(--text-lg);font-weight:700;line-height:1.2;margin-top:6px}
   125	.stages .s{font-size:var(--text-sm);line-height:1.4;color:var(--color-ink-2);margin-top:var(--space-xs)}
   126	
   127	/* 2 unlock */
   128	.unlock{display:grid;grid-template-columns:1080px minmax(0,1fr);gap:var(--space-lg);align-items:stretch}
   129	.rows{display:grid;gap:var(--space-sm)}
   130	.row{display:grid;grid-template-columns:84px minmax(0,1fr);align-items:center;background:var(--color-paper-2);border-radius:var(--radius);padding:var(--space-sm) var(--space-md)}
   131	.row.plus{box-shadow:inset 0 0 0 var(--rule-w) var(--color-accent)}
   132	.row .n{font-family:var(--font-display);font-size:var(--text-lg);font-weight:700;color:var(--color-accent)}
   133	.row .t{font-family:var(--font-display);font-size:48px;font-weight:700;line-height:1.2}
   134	.row .m{display:block;font-family:var(--font-body);font-size:32px;font-weight:400;color:var(--color-ink-2);line-height:1.35;margin-top:4px}
   135	
   136	/* 3 fleet: each row = one scene + its words, the eye reads scene then line */
   137	.fleet-frame{gap:var(--space-md)}
   138	.fleet{display:grid;gap:var(--space-md)}
   139	.frow{display:grid;grid-template-columns:600px minmax(0,1fr);gap:var(--space-lg);align-items:center}
   140	.frow .anc{height:200px}
   141	.frow .ft{font-family:var(--font-display);font-size:var(--text-md);font-weight:700;line-height:1.25}
   142	.frow .ft .hl{white-space:nowrap}
   143	.frow ul{list-style:none;margin-top:var(--space-xs);display:grid;gap:4px}
   144	.frow li{font-size:32px;line-height:1.4;color:var(--color-ink-2);padding-left:30px;position:relative}
   145	.frow li::before{content:"";position:absolute;left:2px;top:.62em;width:10px;height:10px;border-radius:50%;background:var(--color-rule)}
   146	.todo{display:inline-block;margin:0 10px;outline:3px dashed var(--color-accent);outline-offset:4px;border-radius:6px;padding:0 10px;
   147	  color:var(--color-accent);font-family:var(--font-mono);font-size:34px;letter-spacing:0}
   148	
   149	/* 4 shift ring */
   150	.ring{display:grid;grid-template-columns:minmax(0,0.9fr) minmax(0,1.1fr);gap:var(--space-lg);align-items:center}
   151	.ring svg{width:100%;height:auto;display:block;overflow:visible}
   152	.ring svg text{font-family:var(--font-display);fill:var(--color-ink)}
   153	.ring svg .cmd{font-family:var(--font-mono);font-weight:700;fill:var(--color-accent)}
   154	.ring svg .d-arrowhead{fill:var(--color-diagram-line)}
   155	.ring svg .d-arc{stroke:var(--color-diagram-line)}
   156	.ring svg .d-ring{stroke:var(--color-diagram-ring)}
   157	.ring svg .d-hub{fill:var(--color-diagram-hub);stroke:var(--color-diagram-live)}
   158	.ring svg .d-node{fill:var(--color-diagram-node);stroke:var(--color-diagram-idle)}
   159	.ring svg .d-node[data-live]{stroke:var(--color-diagram-live)}
   160	.ring svg .sub{font-family:var(--font-body);fill:var(--color-ink-2);font-weight:500}
   161	
   162	/* 5 numbers */
   163	.big3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-md)}
   164	.big3 .anc{height:230px}
   165	.big3 .col{border-top:var(--rule-w) solid var(--color-accent);padding-top:var(--space-sm)}
   166	.big3 .num{font-family:var(--font-display);font-size:var(--text-display);font-weight:700;color:var(--color-accent);line-height:1}
   167	.big3 .what{font-family:var(--font-display);font-size:var(--text-lg);font-weight:700;margin-top:var(--space-xs)}
   168	.big3 .note{font-size:var(--text-sm);color:var(--color-ink-2);margin-top:var(--space-xs);line-height:1.4}
   169	
   170	/* 6 close (amber) */
   171	.close{display:grid;grid-template-columns:1060px minmax(0,1fr);gap:var(--space-lg);align-items:center}
   172	.slide.amber .lead{color:var(--color-accent-ink)}
   173	.close .anc{height:760px}
   174	
   175	/* chrome: orientation always visible */
   176	#prog{position:absolute;left:0;bottom:0;height:6px;width:0;z-index:5;background:var(--color-accent);transition:width var(--dur-move) var(--ease-move),background-color var(--dur-move)}
   177	#stage.amber #prog{background:var(--color-accent-ink)}
   178	.notes{display:none;position:absolute;left:0;right:0;bottom:0;z-index:9;background:var(--color-notes-bg);color:var(--color-notes);font-family:var(--font-body);font-size:30px;line-height:1.45;padding:28px 100px;border-top:3px solid var(--color-accent)}
   179	body.shownotes .notes{display:block}
   180	#count{position:fixed;right:14px;bottom:10px;color:var(--color-chrome);font:14px var(--font-body);z-index:20}
   181	@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
   182	.fnote{position:absolute;left:var(--space-2xl,140px);bottom:56px;font-size:24px;color:var(--color-ink-3,#7b8189);letter-spacing:.01em}
   183	</style>
