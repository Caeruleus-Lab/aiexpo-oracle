   319	<script>
   320	// navigation layer: works with no WebGL, no CDN, no module support
   321	if (navigator.webdriver && !/[?&]live\b/.test(location.search)) document.documentElement.classList.add('capture');
   322	const S=[...document.querySelectorAll('.slide')];let i=0;
   323	const stage=document.getElementById('stage'),prog=document.getElementById('prog');
   324	function fit(){const s=Math.min(innerWidth/1920,innerHeight/1080);stage.style.transform=`translate(-50%,-50%) scale(${s})`}
   325	function go(n){i=Math.max(0,Math.min(S.length-1,n));S.forEach((x,k)=>x.classList.toggle('on',k===i));
   326	  stage.classList.toggle('amber',S[i].classList.contains('amber'));
   327	  prog.style.width=((i+1)/S.length*100)+'%';
   328	  document.getElementById('count').textContent=(i+1)+' / '+S.length;history.replaceState(null,'','#'+(i+1));
   329	  window.__slide=i;dispatchEvent(new CustomEvent('slide',{detail:i}))}
   330	addEventListener('keydown',e=>{if(e.altKey||e.metaKey||e.ctrlKey)return;if(['ArrowRight','PageDown',' '].includes(e.key)){e.preventDefault();go(i+1)}else if(['ArrowLeft','PageUp'].includes(e.key))go(i-1);else if(e.key==='Home')go(0);else if(e.key==='End')go(S.length-1);else if(e.key==='n'||e.key==='N')document.body.classList.toggle('shownotes')});
   331	addEventListener('resize',fit);fit();go((parseInt(location.hash.slice(1))||1)-1);
